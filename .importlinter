[importlinter]
root_package = lbb

[importlinter:contract:core-purity]
name = core/ has no I/O imports
type = forbidden
source_modules =
    lbb.core
forbidden_modules =
    lbb.adapters
    lbb.web
    lbb.app

[importlinter:contract:web-isolation]
name = web/ cannot reach adapters directly
type = forbidden
source_modules =
    lbb.web
forbidden_modules =
    lbb.adapters
