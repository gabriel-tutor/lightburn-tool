<?xml version='1.0' encoding='UTF-8'?>
<!--
  SYNTHETIC TEMPLATE — NEEDS LIGHTBURN VERIFICATION

  Hand-authored from community-documented `.lbrn2` schema (nuCarve +
  forum.lightburnsoftware.com + sample .lbrn2 files in the wild).
  Must be opened in LightBurn at least once to confirm round-trip
  before the project ships to the client. See task #22 / docs/plans/
  for the verification checklist.

  Canvas: 95×110mm (Wallet — Small SKU).
  Layer 00 (C00, black): vector cut, 20% power, 1000 mm/min.
  Group "DESIGN_PLACEHOLDER" carries the design that gets replaced
  by build_lbrn2() at job time.
-->
<LightBurnProject AppVersion="1.7.04" FormatVersion="1" MaterialHeight="0" MirrorX="False" MirrorY="False">
    <VariableText>
        <Start Value="0"/>
        <End Value="999"/>
        <Current Value="0"/>
        <Increment Value="1"/>
        <AutoAdvance Value="0"/>
    </VariableText>
    <UIPrefs>
        <Optimize_ByLayer Value="1"/>
        <Optimize_ByGroup Value="-1"/>
        <Optimize_ByPriority Value="1"/>
        <Optimize_WhichDirection Value="0"/>
        <Optimize_InnerToOuter Value="1"/>
        <Optimize_ByDirection Value="0"/>
        <Optimize_ReduceTravel Value="1"/>
        <Optimize_HideBacklash Value="0"/>
        <Optimize_ReduceDirChanges Value="0"/>
        <Optimize_ChooseCorners Value="0"/>
        <Optimize_AllowReverse Value="1"/>
        <Optimize_RemoveOverlaps Value="0"/>
        <Optimize_OptimalEntryPoint Value="1"/>
    </UIPrefs>
    <CutSetting type="Cut">
        <index Value="0"/>
        <name Value="C00"/>
        <minPower Value="20"/>
        <maxPower Value="20"/>
        <minPower2 Value="20"/>
        <maxPower2 Value="20"/>
        <speed Value="16.6667"/>
        <kerf Value="0"/>
        <zOffset Value="0"/>
        <enableLaser1 Value="1"/>
        <enableLaser2 Value="0"/>
        <startDelay Value="0"/>
        <endDelay Value="0"/>
        <throughPower Value="0"/>
        <throughPower2 Value="0"/>
        <enableCutThroughStart Value="0"/>
        <enableCutThroughEnd Value="0"/>
        <priority Value="0"/>
        <frequency Value="20000"/>
        <overrideFrequency Value="0"/>
        <PPI Value="200"/>
        <enablePPI Value="0"/>
        <doOutput Value="1"/>
        <hide Value="0"/>
        <runBlower Value="0"/>
        <autoBlower Value="0"/>
        <blowerSpeedOverride Value="0"/>
        <blowerSpeedPercent Value="100"/>
        <overcut Value="0"/>
        <rampLength Value="0"/>
        <rampOuter Value="0"/>
        <forceConstantPower Value="0"/>
        <numPasses Value="1"/>
        <zPerPass Value="0"/>
        <perforate Value="0"/>
        <perfLen Value="0.1"/>
        <perfSkip Value="0.1"/>
        <dotMode Value="0"/>
        <dotTime Value="0"/>
        <dotSpacing Value="0"/>
        <tabsEnabled Value="0"/>
        <manualTabs Value="1"/>
        <tabSize Value="0.5"/>
        <tabCount Value="1"/>
        <tabSpacing Value="50"/>
        <skipInnerTabs Value="0"/>
        <tabsUseSpacing Value="1"/>
        <tabCutPower Value="0"/>
        <scanOpt Value="mergeAll"/>
        <bidir Value="1"/>
        <crossHatch Value="0"/>
        <overscan Value="1"/>
        <overscanPercent Value="2.5"/>
        <floodFill Value="0"/>
        <floodFillGap Value="0.1"/>
        <floodOverlap Value="0"/>
        <interval Value="0.1"/>
        <angle Value="0"/>
        <imageMode Value="grayscale"/>
        <halftoneAngle Value="22.5"/>
        <halftoneCells Value="6"/>
        <screenType Value="line"/>
        <usePassThrough Value="0"/>
        <passThroughParam Value=""/>
    </CutSetting>
    <Shape Type="Group" Name="DESIGN_PLACEHOLDER">
        <XForm>1 0 0 1 0 0</XForm>
        <Children>
            <Shape Type="Path" CutIndex="0"><XForm>1 0 0 1 0 0</XForm><VertList>V10 10c0x1c1x1V60 10c0x1c1x1V60 50c0x1c1x1V10 50c0x1c1x1</VertList><PrimList>L0 1L1 2L2 3L3 0</PrimList></Shape></Children>
    </Shape>
    <Notes ShowOnLoad="0" Notes=""/>
</LightBurnProject>
