/* Flanacom Tool — light theme.
   Tokens mirror src/lbb/ui/theme/tokens.py — keep them in sync.
   QSS limitations: no @keyframes, no CSS variables. Animations are done
   via QPropertyAnimation in widget code; this file is structure + state.
*/

* {
    font-family: "SF Pro Text", "SF Pro Display", "Segoe UI Variable Text",
                 "Segoe UI", "Inter", "Helvetica Neue", sans-serif;
    color: #1A1A1A;
    font-size: 13px;
    selection-background-color: #F58A1F;
    selection-color: #FFFFFF;
}

QMainWindow, QDialog, QWidget {
    background: #FAFAFA;
}

/* ── Headings ──────────────────────────────────────────────────────────── */

QLabel#wordmark {
    font-family: "SF Pro Display", "Segoe UI Variable Display", "Segoe UI",
                 "Inter", "Helvetica Neue", sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: #1A1A1A;
    letter-spacing: -0.2px;
}

QLabel#wordmarkAccent {
    font-family: "SF Pro Display", "Segoe UI Variable Display", "Segoe UI",
                 "Inter", "Helvetica Neue", sans-serif;
    font-size: 17px;
    font-weight: 400;
    color: #6B7280;
    letter-spacing: -0.2px;
}

QLabel#displayHeading {
    font-family: "SF Pro Display", "Segoe UI Variable Display", "Segoe UI",
                 "Inter", "Helvetica Neue", sans-serif;
    font-size: 22px;
    font-weight: 600;
    color: #1A1A1A;
    letter-spacing: -0.4px;
}

QLabel#sectionLabel {
    color: #6B7280;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}

QLabel#monoCode {
    font-family: "SF Mono", "Cascadia Mono", "JetBrains Mono",
                 "Menlo", "Consolas", monospace;
    font-size: 14px;
    font-weight: 500;
    color: #F58A1F;
    letter-spacing: 0.5px;
}

QLabel#dim { color: #6B7280; }
QLabel#faint { color: #9CA3AF; }

/* ── Status pill ───────────────────────────────────────────────────────── */

QLabel#statusOk    { color: #10B981; font-weight: 600; }
QLabel#statusWarn  { color: #F59E0B; font-weight: 600; }
QLabel#statusError { color: #DC2626; font-weight: 600; }

/* ── Buttons ───────────────────────────────────────────────────────────── */

QPushButton {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 9px 18px;
    font-weight: 500;
    color: #1A1A1A;
}
QPushButton:hover {
    background: #F5F5F4;
    border-color: #D1D5DB;
}
QPushButton:pressed {
    background: #EDEDEC;
}
QPushButton:focus {
    border: 1px solid #F58A1F;
    outline: none;
}
QPushButton:disabled {
    color: #9CA3AF;
    background: #F5F5F4;
    border-color: #E5E7EB;
}

QPushButton#sendButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #FFA947, stop:1 #F58A1F);
    color: #FFFFFF;
    font-weight: 600;
    border: 1px solid #D97706;
    padding: 10px 22px;
}
QPushButton#sendButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #FFB76A, stop:1 #FF9F3E);
}
QPushButton#sendButton:pressed {
    background: #D97706;
    border-color: #B45309;
}
QPushButton#sendButton:disabled {
    background: #F5F5F4;
    color: #9CA3AF;
    border-color: #E5E7EB;
}

QPushButton#ghostButton {
    background: transparent;
    border: 1px solid transparent;
    color: #6B7280;
    padding: 7px 14px;
    border-radius: 8px;
    font-weight: 500;
}
QPushButton#ghostButton:hover {
    color: #F58A1F;
    background: #F5F5F4;
}
QPushButton#ghostButton:pressed {
    background: #EDEDEC;
    color: #D97706;
}

/* ── Drop zone — the marquee surface of the home screen ───────────────── */

QFrame#dropZone {
    border: 1.5px dashed #F58A1F;
    border-radius: 18px;
    background: #FFFFFF;
}
QFrame#dropZone[active="true"] {
    border: 2px solid #F58A1F;
    background: #FFF3E5;
}
QFrame#dropZone QLabel { background: transparent; }

QLabel#dropIcon {
    font-family: "SF Pro Display", "Segoe UI Variable Display", "Segoe UI",
                 "Inter", "Helvetica Neue", sans-serif;
    font-size: 52px;
    font-weight: 200;
    color: #F58A1F;
}
QFrame#dropZone[active="true"] QLabel#dropIcon { color: #D97706; }

QLabel#dropTitle {
    font-family: "SF Pro Display", "Segoe UI Variable Display", "Segoe UI",
                 "Inter", "Helvetica Neue", sans-serif;
    font-size: 20px;
    font-weight: 500;
    color: #1A1A1A;
    letter-spacing: -0.3px;
}
QLabel#dropSubtitle {
    color: #6B7280;
    font-size: 13px;
}
QLabel#dropHelper {
    font-family: "SF Mono", "Cascadia Mono", "JetBrains Mono",
                 "Menlo", "Consolas", monospace;
    font-size: 11px;
    color: #9CA3AF;
    letter-spacing: 0.3px;
}

/* ── Preview screen — info panels ─────────────────────────────────────── */

QFrame#previewThumbCard {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

QLabel#layerSetup {
    color: #4B5563;
    font-size: 12px;
}

/* ── Order view — item rows + progress ────────────────────────────────── */

QFrame#orderItemRow {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}
QFrame#orderItemRow:hover {
    border-color: #FBBF77;
    background: #FFFBF5;
}

QFrame#itemsBox {
    background: transparent;
    border: none;
}

QProgressBar {
    background: #F5F5F4;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    text-align: center;
    color: #1A1A1A;
    font-size: 11px;
    font-weight: 600;
    min-height: 18px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #FFA947, stop:1 #F58A1F);
    border-radius: 5px;
}

/* ── Tables (admin) ───────────────────────────────────────────────────── */

QTableWidget, QTableView {
    background: #FFFFFF;
    alternate-background-color: #FAFAFA;
    gridline-color: #F5F5F4;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    selection-background-color: #FFF3E5;
    selection-color: #1A1A1A;
    show-decoration-selected: 1;
    outline: none;
}
QTableWidget::item, QTableView::item {
    padding: 10px 12px;
    border: none;
}
QTableWidget::item:hover, QTableView::item:hover {
    background: #F5F5F4;
}
QHeaderView::section {
    background: #FAFAFA;
    color: #6B7280;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}
QHeaderView::section:first { border-top-left-radius: 8px; }
QHeaderView::section:last { border-top-right-radius: 8px; }

/* ── Dialogs / form fields ────────────────────────────────────────────── */

QLineEdit, QComboBox {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 8px 12px;
    color: #1A1A1A;
    selection-background-color: #F58A1F;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #F58A1F;
}
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    selection-background-color: #FFF3E5;
    selection-color: #1A1A1A;
    color: #1A1A1A;
    padding: 4px;
    outline: none;
}

QMessageBox { background: #FFFFFF; }
QMessageBox QLabel { color: #1A1A1A; font-size: 13px; }
QMessageBox QPushButton { min-width: 80px; }

/* ── Tabs ─────────────────────────────────────────────────────────────── */

QTabWidget::pane {
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    background: #FFFFFF;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #6B7280;
    padding: 8px 16px;
    border: 1px solid transparent;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QTabBar::tab:selected {
    background: #FFFFFF;
    color: #1A1A1A;
    border: 1px solid #E5E7EB;
    border-bottom-color: #FFFFFF;
}
QTabBar::tab:hover:!selected { color: #1A1A1A; }

/* ── Scrollbars ───────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #D1D5DB;
    min-height: 32px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover { background: #9CA3AF; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #D1D5DB;
    min-width: 32px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover { background: #9CA3AF; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }
